{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge entry",
  "description": "A small searchable YAML record that points to an authoritative Markdown page.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "status",
    "tags",
    "summary",
    "source",
    "document"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable, lowercase kebab-case identifier."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Open category label used for discovery."
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "provisional",
        "deferred"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short discovery text; the linked Markdown page remains authoritative."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Where the recorded information came from."
    },
    "document": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the authoritative Markdown page, relative to this YAML file."
    }
  }
}
